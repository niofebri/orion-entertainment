---
const themes = [
  'Production Planning',
  'Event Execution',
  'Creative Direction',
  'Technical Coordination',
  'Visual Storytelling',
  'Post Production',
];

// Ganti path ini dengan foto dokumentasi Orion Entertainment kamu
const aboutImages = {
  primary: '/images/tentangkami/tentangkami2.jpg',
  secondary: '/images/tentangkami/tentangkami1.jpg',
  tertiary: '/images/tentangkami/tentangkami3.jpg',
};
---

<section class="py-28 px-16 max-lg:py-20 max-lg:px-6 border-t border-border grid grid-cols-2 gap-20 max-lg:grid-cols-1 max-lg:gap-10" id="about">
  <div>
    <div class="text-[10px] font-medium tracking-[0.2em] uppercase text-dark-gray mb-12 reveal"> <span class="text-accent">||</span> Tentang Kami <span class="text-accent">||</span></div> 
    <h2 class="font-display italic text-[clamp(36px,4vw,64px)] font-normal leading-[1.15] text-off-white mb-10 reveal">
      Dari Ide<br />Menjadi Pengalaman
    </h2>
    <p class="text-[15px] text-gray leading-relaxed max-w-[520px] reveal">
      Kami memadukan produksi, arahan kreatif, dan eksekusi teknis untuk menghadirkan acara serta cerita visual yang direncanakan dengan matang, dieksekusi dengan baik, dan memiliki makna bagi audiens.
    </p>
    <div class="mt-12 flex flex-wrap gap-3 reveal">
      {themes.map((t) => (
        <span class="text-[11px] tracking-[0.1em] uppercase text-dark-gray py-2 px-4 border border-border">
          {t}
        </span>
      ))}
    </div>
  </div>

  <!-- Three overlapping images -->
 <div class="relative reveal self-start max-lg:mt-4 min-h-[400px] max-lg:min-h-[320px]">
    <div class="about-img-wrap absolute top-15 left-0 w-[62%] aspect-[4/3] overflow-hidden">
      <img src={aboutImages.primary} alt="Dokumentasi Orion Entertainment" class="about-img w-full h-full object-cover transition-transform duration-500" loading="lazy" />
    </div>
    <div class="about-img-wrap absolute top-0 right-0 w-[50%] aspect-square overflow-hidden border-4 border-black shadow-2xl z-10">
      <img src={aboutImages.secondary} alt="Dokumentasi Orion Entertainment" class="about-img w-full h-full object-cover transition-transform duration-500" loading="lazy" />
    </div>
    <div class="about-img-wrap absolute bottom-0 right-[20%] w-[50%] aspect-[4/3] overflow-hidden border-4 border-black shadow-2xl z-20">
      <img src={aboutImages.tertiary} alt="Dokumentasi Orion Entertainment" class="about-img w-full h-full object-cover transition-transform duration-500" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .about-img-wrap:hover .about-img {
    transform: scale(1.08);
  }
</style>